# Environment variables
.env
*.env
.env.*
!.env.example

# Terraform. These are ** patterns, not terraform/ prefixes: the bootstrap
# root is a second root configuration with its own .terraform/ directory, and
# a prefixed pattern missed it — one `git add -A` away from committing a 500MB
# provider binary.
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
terraform/terraform.tfvars
!terraform/terraform.tfvars.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# Docker
*.tar

# SSH keys
*.pem
*.key
id_rsa
id_rsa.pub

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local backups taken by scripts/backup-tables.sh. These hold agent API key
# hashes and customers' whitelisted IPs — they must never reach the repo.
aiops-backups/
*.backup.json

# other
dump-code.sh
repo_dump.md
.sdlc/
.ruff_cache/
.mypy_cache/
.venv/
.venv*/
venv/
aiops-terraform_accessKeys.csv
